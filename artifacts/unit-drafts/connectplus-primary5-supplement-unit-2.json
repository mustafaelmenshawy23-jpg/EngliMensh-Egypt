      "title": "Grammar Focus",
      "items": [
        {
          "itemId": "gram_1",
          "content": {
            "rule": "Present Perfect Tense with 'ever' and 'never'",
            "explanation": "We use the Present Perfect tense (have/has + past participle) to talk about past experiences. 'Ever' is used in questions to ask about experiences in someone's life, while 'never' is used in negative statements to show zero experience.",
            "example": "Have you ever seen an elephant? No, I have never seen an elephant.",
            "origin": "supplementary",
            "sourcePdfPage": 54,
            "fieldOrigins": {
              "rule": "supplementary",
              "explanation": "supplementary",
              "example": "supplementary"
            }
          },
          "notes": "AI-generated supplementary practice; not printed in source book. Teacher review required.",
          "reviewStatus": "needs_review"
        },
        {
          "itemId": "gram_2",
          "content": {
            "rule": "Past Simple Tense vs. Present Perfect Tense",
            "explanation": "The Past Simple expresses completed actions at a specified time in the past (e.g., yesterday, last year). The Present Perfect connects past events to the present without naming a specific past time.",
            "example": "She visited Luxor last year. She has visited Luxor twice.",
            "origin": "supplementary",
            "sourcePdfPage": 51,
            "fieldOrigins": {
              "rule": "supplementary",
