      "items": [
        {
          "itemId": "grammar-1",
          "content": {
            "rule": "Expressing quantity using 'too much', 'too many', and 'enough'",
            "explanation": "Use 'There is / isn't too much' with uncountable nouns (like water or salt). Use 'There are / aren't too many' with plural countable nouns (like cars or pencils). Use 'enough' with singular uncountable or plural countable nouns to express adequate quantity.",
            "example": "There is too much water on the surface and there are too many cars.",
            "origin": "supplementary",
            "sourcePdfPage": 204,
