    {
      "type": "grammar",
      "title": "Language Structures",
      "items": [
        {
          "itemId": "p1u3-gr-1",
          "content": {
            "rule": "Introducing family members",
            "explanation": "Use This is my + family member. Use They are my parents for both parents.",
            "example": "This is my father. This is my mother. They are my parents.",
            "origin": "source",
            "sourcePdfPage": 43
          },
          "reviewStatus": "needs_review",
          "origin": "source",
          "notes": "Based on the printed language model; verify against original PDF scan."
        },
        {
          "itemId": "p1u3-gr-2",
          "content": {
            "rule": "Talking about family numbers",
            "explanation": "Use I have + number + plural family member.",
            "example": "I have 1 brother. I have 2 sisters.",
            "origin": "source",
            "sourcePdfPage": 43
          },
          "reviewStatus": "needs_review",
          "origin": "source",
          "notes": "Based on the printed language model; verify against original PDF scan."
        },
        {
          "itemId": "p1u3-gr-3",
          "content": {
            "rule": "Asking about quantity",
            "explanation": "Use How many...? Answer There is 1... or There are...",
            "example": "There is 1 butterfly. There are 4 books.",
            "origin": "source",
            "sourcePdfPage": 53
          },
          "reviewStatus": "needs_review",
          "origin": "source",
          "notes": "Based on the printed language model; verify against original PDF scan."
        }
      ]
